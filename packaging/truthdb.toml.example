# TruthDB configuration overrides.
#
# Every line in this file is commented out by default. The values shown are
# the embedded defaults built into the binary; uncomment a line to override.
# After editing, restart the service: `systemctl restart truthdb`.
#
# Storage paths inside this file are resolved relative to the systemd
# StateDirectory, so the default `path = "truth.db"` ends up at
# /var/lib/truthdb/truth.db. Use an absolute path to override.

[network]
# addr = "0.0.0.0"
# port = 9623

[storage]
# path = "truth.db"
# size_gib = 10
# wal_ratio = 0.05
# metadata_ratio = 0.08
# snapshot_ratio = 0.02
# allocator_ratio = 0.02
# reserved_ratio = 0.17
#
# [s3]
# S3-compatible HTTP API (path-style addressing). Requests are signed with
# AWS SigV4 using access keys created over the native protocol:
#   truthdb-cli> s3 create access key
# enabled = true
# addr = "0.0.0.0"
# port = 9000
# region = "us-east-1"
# tls_cert = "/etc/truthdb/s3.crt"   # both set = HTTPS
# tls_key = "/etc/truthdb/s3.key"
#
# [encryption]
# Encryption at rest: a database created while a master key is configured is
# encrypted (its pages, log, search snapshot, spill pages and backups); it, its
# backups and its standbys do not open without that key. One of:
# master_key_file = "/etc/truthdb/master.keys"  # lines "<id> <64 hex digits>",
#                                               # the first key current; mode 0600,
#                                               # owned by the server's user
# key_command = ["/usr/local/bin/truthdb-kms"]  # run with "wrap" or "unwrap" appended:
#                                               # wrap reads the database key as hex on
#                                               # stdin and prints its wrapped form;
#                                               # unwrap reads that and prints the hex key
# To encrypt an existing database: configure a master key here, restart, and
# run `encryption enable`; the server converts it in the background
# (`encryption status` shows progress). Standbys cannot follow the change:
# reseed them from a backup taken afterwards, and start a new backup chain
# with a full backup.
# To rotate the master key: put the new key first in the key file (keep the
# old one) and run `encryption rotate master key` on the primary and on every
# standby (each file holds its own copy of the wrapped key; a standby seeded
# from a backup started after the rotation succeeded already has the new
# one). Remove the old key only after every rotation reported success. A
# backup started before the rotation succeeded still needs the old key to
# restore, and so does anything seeded or restored from it.
# To replace the database key itself: run `encryption rotate database key`
# on the primary; the server rewrites everything under the new key in the
# background (`encryption status` shows progress), and the old one is gone
# once it finishes. As for `encryption enable`: reseed the standbys from a
# backup taken afterwards, and start a new backup chain with a full backup.
