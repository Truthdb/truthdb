# Multiple databases (A2): CREATE/DROP DATABASE, USE, three-part names,
# DB_ID/DB_NAME, per-database sys views. The session starts in `truthdb`.

statement ok
CREATE DATABASE hr

# duplicate (1801), case-insensitively
statement error
CREATE DATABASE HR

query TI rowsort
SELECT name, database_id FROM sys.databases
----
hr 2
truthdb 1

query I
SELECT DB_ID()
----
1

query I
SELECT DB_ID('hr')
----
2

query T
SELECT DB_NAME(2)
----
hr

query T
SELECT DB_NAME(99)
----
NULL

statement ok
USE hr

query TI
SELECT DB_NAME(), DB_ID()
----
hr 2

statement ok
CREATE TABLE t (id INT NOT NULL PRIMARY KEY)

statement ok
INSERT INTO t VALUES (1)

statement ok
USE truthdb

# hr's table is invisible to this session's catalog views...
query I
SELECT COUNT(*) FROM sys.tables
----
0

# ...but reachable by its three-part name,
query I
SELECT COUNT(*) FROM hr.dbo.t
----
1

# The same bare name in two databases: two distinct tables.
statement ok
CREATE TABLE t (id INT NOT NULL PRIMARY KEY)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

query I
SELECT COUNT(*) FROM t
----
2

query I
SELECT COUNT(*) FROM hr.dbo.t
----
1

# Cross-database DML works — one shared log underneath.
statement ok
INSERT INTO hr.dbo.t VALUES (7)

query I
SELECT COUNT(*) FROM hr.dbo.t
----
2

